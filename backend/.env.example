APP_NAME=Agentic Workflow Engine
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8080
API_BASE_PATH=/api
FRONTEND_URL=http://127.0.0.1:5173

JWT_SECRET=change-me-before-production
JWT_EXPIRES_MINUTES=60
# Development defaults to open signup; production must set this to false.
ALLOW_PUBLIC_REGISTRATION=true
# Required only while the user store is empty. There are deliberately no defaults.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
DEV_USER_ROLE=
CHAT_USER_ROLE_OVERRIDE=

# Memory is the safe zero-dependency default. For durable state, set postgres
# and provide a unique 32-byte base64/hex key kept outside source control.
STORAGE_DRIVER=memory
STORAGE_ENCRYPTION_KEY=
DATABASE_URL=postgres://workflow:workflow@localhost:5432/workflow?sslmode=disable
REDIS_URL=redis://localhost:6379/0

MCP_BASE_URL=
MCP_MODE=remote
MCP_TIMEOUT_SECONDS=15

DATASET_ROOT=./dataset
TOOL_REGISTRY_PATH=./configs/registries/all_tools_master_registry.json
RULE_REGISTRY_PATH=./configs/registries/all_rules_master_registry.json
# Optional isolated sample preview. It validates configs/seed without writing
# to or publishing into either evaluated master registry.
SEED_SAMPLE_DATA=false
SAMPLE_TOOL_SEED_PATH=./configs/seed/sample_tools.json
SAMPLE_RULE_SEED_PATH=./configs/seed/sample_rules.json

SEMANTIC_SEARCH_MODE=external_embedding
SEMANTIC_SEARCH_URL=http://localhost:8090/search
SEMANTIC_SEARCH_TOP_K_TOOLS=10
SEMANTIC_SEARCH_TOP_K_RULES=15
SEMANTIC_SEARCH_TOP_K_TEMPLATES=5
SEMANTIC_SEARCH_TOP_K_EXAMPLES=5
SEMANTIC_SEARCH_ALLOW_LEXICAL_FALLBACK=false
SEMANTIC_FALLBACK=off
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
INDEX_PROFILE=dev
INDEX_MAX_ITEMS_PER_FILE=25
INDEX_MAX_TOOLS_PER_FILE=0
INDEX_MAX_RULES_PER_FILE=0
INDEX_MAX_TEMPLATES_PER_FILE=0
INDEX_MAX_EXAMPLES_PER_FILE=25
EMBED_BATCH_SIZE=32
EMBEDDING_TEXT_MAX_CHARS=2000
REBUILD_SEMANTIC_INDEX=false
OLLAMA_EMBEDDING_TIMEOUT_SECONDS=60
INDEX_INCLUDE_TOOLS=true
INDEX_INCLUDE_RULES=true
INDEX_INCLUDE_TEMPLATES=true
INDEX_INCLUDE_EXAMPLES=true
INDEX_INCLUDE_VALIDATOR_CASES=false
SEMANTIC_SEARCH_LOG_LEVEL=INFO

WORKFLOW_GENERATION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CANDIDATE_COUNT=5
CHAT_TRACE_BOXES=true

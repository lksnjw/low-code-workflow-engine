# Relevant backend settings only; merge into your complete environment.
# Never put the catalog token or storage encryption key in frontend VITE_* vars.
MCP_TRANSPORT=erpbridge-mcp
MCP_MODE=remote
# Host root only; the client adds /mcp/.
ERPBRIDGE_BASE_URL=https://your-erpbridge-host.example
# The server owner issues this catalog/admin credential. This name grants no role.
ERPBRIDGE_MCP_TOKEN_ENV=ERPBRIDGE_CATALOG_TOKEN
ERPBRIDGE_CATALOG_TOKEN=REPLACE_IN_PRIVATE_BACKEND_SECRET_STORAGE
# Explicit opt-in: only the built-in role_admin / Platform Admin uses this
# server credential for governed operations. Other roles always need personal tokens.
# Changing the server credential invalidates old admin job bindings; no auto-rebind.
ERPBRIDGE_ADMIN_ENV_ACCESS=true
# Opt-in direct administrator chat: live schemas, exact in-chat confirmations,
# durable dispatch intentions. Does not relax any other role or ERP token.
ERPBRIDGE_ADMIN_CHAT_ACTIONS=true
# Use actual server-defined role names. This mapping grants no remote permissions.
ERPBRIDGE_ROLE_MAP={"Platform Admin":"admin","Workflow Builder":"workflow_builder","Client":"client"}
# Keep the existing stable STORAGE_ENCRYPTION_KEY in private backend storage.
# Individual users save their own tokens through Profile, not environment vars.
